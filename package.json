{
  "name": "kitchen-flooring-depot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build && node scripts/prepare-standalone.mjs",
    "start": "node init && node .next/standalone/server.js",
    "start:next": "node init && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import:content": "node scripts/import-source.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
