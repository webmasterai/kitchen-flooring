# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (exclude secrets)
.env
.env*.local
.env.production
.env.development
!.env.example

# runtime CMS storage, credentials & drafts (server runtime only)
/data/backups/
/data/drafts/
/data/enquiries/*
!/data/enquiries/.gitkeep
/data/users.json
/data/audit.json
/data/sessions/
/data/sessions.json

# temporary files & screenshots in root
*.png
!public/**
*.mp4
!public/**

# vercel
.vercel
