# Public site URL used for canonical/sitemap/metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Directory for persisted quote enquiries (outside web root in production)
ENQUIRY_DATA_DIR=./data/enquiries

# Salt for hashing client IPs in enquiry metadata (server-only)
IP_HASH_SALT=replace-with-long-random-string

# SMTP notification (server-only — never expose to the client)
# Leave unset in development to skip email and keep notificationStatus=skipped
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
QUOTE_NOTIFY_TO=hr@kitchenflooringdepot.com
QUOTE_NOTIFY_FROM=
